{
  "name": "@footebas/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@footebas/contracts": "workspace:*",
    "@footebas/database": "workspace:*",
    "@footebas/domain": "workspace:*",
    "@footebas/engine": "workspace:*",
    "zod": "4.4.3",
    "@footebas/content": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
