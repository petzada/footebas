{
  "name": "@footebas/sim-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "calibrate": "tsx src/cli.ts --calibrate --matches=10000",
    "lint": "eslint src --max-warnings=0",
    "phase1-gate": "tsx src/cli.ts --phase1-gate --matches=10000 --seasons=1000",
    "phase3-gate": "tsx src/cli.ts --phase3-gate --rounds=14",
    "phase4-gate": "tsx src/cli.ts --phase4-gate --seasons=25",
    "phase5-gate": "tsx src/cli.ts --phase5-gate --seasons=2000",
    "playthrough": "tsx src/cli.ts --playthrough --rounds=14",
    "season": "tsx src/cli.ts --season",
    "smoke": "tsx src/cli.ts --smoke",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "variance": "tsx src/cli.ts --variance --careers=10"
  },
  "dependencies": {
    "@footebas/content": "workspace:*",
    "@footebas/domain": "workspace:*",
    "@footebas/engine": "workspace:*",
    "@footebas/testing": "workspace:*"
  }
}
