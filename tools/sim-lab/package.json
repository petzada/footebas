{
  "name": "@footebas/sim-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "calibrate": "tsx src/cli.ts --calibrate --matches=10000",
    "lint": "eslint src --max-warnings=0",
    "smoke": "tsx src/cli.ts --smoke",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@footebas/domain": "workspace:*",
    "@footebas/engine": "workspace:*",
    "@footebas/testing": "workspace:*"
  }
}
