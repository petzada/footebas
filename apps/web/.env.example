# Copie para apps/web/.env.local. Todas são públicas (NEXT_PUBLIC_*) e entram
# no bundle do navegador no build: nunca coloque segredos aqui.

# API autoritativa (Cloudflare Worker), sem barra no final. Vazia = demo
# offline em memória, sem login real.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Projeto Supabase usado pelo login (Google e link mágico).
NEXT_PUBLIC_SUPABASE_URL=https://wjisqiiwsuykfbmqglfb.supabase.co
# Chave pública anon/publishable (Painel Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# supabase (padrão) = login real. dev = sessão de desenvolvimento local via
# POST /v1/dev/session, só com a API rodando em modo dev.
NEXT_PUBLIC_AUTH_MODE=supabase
