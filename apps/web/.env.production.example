# Variáveis públicas do build de produção do web (inlinadas no bundle pelo Next).
# Copie para `.env.production` (ignorado pelo git) ou exporte no shell/CI antes de
# `pnpm --filter @footebas/web cf:build` / `cf:deploy`.
NEXT_PUBLIC_API_URL=https://api.footebas.com.br
NEXT_PUBLIC_SUPABASE_URL=https://wjisqiiwsuykfbmqglfb.supabase.co
NEXT_PUBLIC_AUTH_MODE=supabase
# Anon key do Supabase: pegue em Supabase > Project Settings > API. Não versione.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
